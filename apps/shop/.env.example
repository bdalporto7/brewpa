# Same Turso database as apps/roasting (that app owns the schema/migrations).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local-only fallback when the Turso vars aren't set.
DATABASE_URL="file:../roasting/prisma/dev.db"

# Which roasting team's coffees this storefront sells (Team.id).
SHOP_TEAM_ID=

# Public base URL of this site, e.g. https://cybar-shop.vercel.app
SHOP_BASE_URL=http://localhost:3001

# Square (checkout). Sandbox first; swap all four for production values at launch.
# developer.squareup.com -> your app -> Credentials (toggle Sandbox/Production).
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
# Developer Console -> Locations (sandbox has a "Default Test Account" location).
SQUARE_LOCATION_ID=
# Developer Console -> your app -> Webhooks -> Subscriptions (needs a public URL;
# subscribe to payment.updated).
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Where coffees come from: unset/"db" = our database, "square" = Square's catalog and inventory.
SHOP_SOURCE=
