// GENERATED COPY of apps/roasting/prisma/schema.prisma — do not edit here.
// Edit the roasting app's schema (it owns migrations), then run `npm run sync-schema`.

// Prisma schema for the roasting app (built for a Fresh Roast SR800).
// Bean = green bean inventory. RoastSession = one roast: pending
// (startedAt null — bean/weight picked, fan/heat being dialed in, timer not
// running yet) -> live (startedAt set) -> completed (endedAt set).
// RoastEvent = a timestamped entry logged during a session (fan/heat change,
// temp reading, crack marker, note, or drop).
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bean {
  id                    String    @id @default(cuid())
  name                  String
  origin                String
  producer              String?
  process               String
  variety               String?
  supplier              String?
  supplierUrl           String?
  purchaseDate          DateTime  @default(now())
  purchasePrice         Float?
  weightGrams           Float
  remainingGrams        Float
  notes                 String?
  // Uploaded via Vercel Blob (src/lib/actions.ts's uploadBeanPhotoIfProvided)
  // — a real hosted URL, not user-entered text like supplierUrl above.
  // Mainly for the Drops shop-grid card; shown on the bean's own page too.
  photoUrl              String?
  // Optional physical attributes an AI roast suggestion can factor in
  // (src/lib/roastAdvisor.ts) — left null when the roaster hasn't measured
  // them; the suggestion prompt just says so rather than guessing.
  moisturePercent       Float?
  densityGramsPerLiter  Float?
  // Pulled from supplierUrl via fetchSupplierInfo/supplierExtractor.ts
  // (an LLM extraction, not a guaranteed-accurate scrape) — also fed into
  // the AI roast-suggestion prompt. Always hand-editable regardless of
  // whether the fetch worked, since scraping an arbitrary supplier site is
  // inherently unreliable (bot detection, JS-rendered pages a plain
  // server fetch can't see). tastingNotesFetchedAt is provenance so the
  // UI can show how stale/verified the text is, not just display it as
  // fact.
  tastingNotes          String?
  qGrade                Float?
  tastingNotesFetchedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Dashboard's LowStockBanner — a one-time "yes, I know" dismissal, not a
  // permanent per-bean setting: cleared automatically once this bean is
  // restocked (updateBean, when weightGrams goes up), since a fresh
  // purchase is the one unambiguous signal that whatever the roaster
  // already knew about the old low-stock situation no longer applies.
  // Deliberately one flag covering green stock, roasted stock, and the
  // burn-rate projection alike — the banner doesn't ask which reason
  // someone's dismissing, so a bean shouldn't need three separate flags
  // for three sub-warnings it treats as one "running low" notice.
  lowStockDismissed Boolean @default(false)

  // Business planning thresholds — all optional, all feed future alerts:
  // reorderLevelGrams flags "running low" when remainingGrams drops below
  // it; leadTimeDays is the supplier's lead time so a reorder alert can
  // name an order-by date; agingThresholdDays flags green sitting
  // unroasted longer than this. No behavior reads them yet — chunk 1 just
  // stores and edits them.
  reorderLevelGrams  Float?
  leadTimeDays       Int?
  agingThresholdDays Int?

  // The one roast of this bean to target/compare future roasts against —
  // set explicitly (not just "most recent"), null until the roaster marks
  // one. A distinct relation from roastSessions below since a bean can
  // reference at most one of its own sessions this way.
  goldenRoastId String?       @unique
  goldenRoast   RoastSession? @relation("BeanGoldenRoast", fields: [goldenRoastId], references: [id], onDelete: SetNull)

  roastSessions   RoastSession[]   @relation("BeanRoasts")
  productionPlans ProductionPlan[]
  blendComponents BlendComponent[]
  lotCuppingNotes CuppingNote[]
  dropItems       DropItem[]
  dropOrderItems  DropOrderItem[]
  shopListing     BeanListing?
  shopOrderItems  ShopOrderItem[]
  // Brews live on RoastSession, not here, since roasted stock (what a brew
  // actually draws down) is tracked per roast, not per bean — see Brew.

  // A Bean belongs to the team that roasts it — shared by every member of
  // that team (see Team's own doc comment), not an individual account.
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([origin])
  @@index([createdAt])
  @@index([teamId])
}

// A monthly roast commitment: how much roasted coffee to produce in a
// given month, optionally tied to a bean and a roaster. The business
// cycle is "buy green 1st–15th → roast/fulfill the following month", so
// `month` is the *roast* month as "YYYY-MM" — a plain string, not a
// DateTime, because no day or time is meaningful here (validated in
// plan-actions.ts). Plans never move stock; they're commitments, and
// actual RoastSessions decrement inventory when they happen.
model ProductionPlan {
  id          String  @id @default(cuid())
  month       String
  targetGrams Float
  // planned | in-progress | completed — plain string, validated in the
  // action (this schema uses strings, not enums, throughout).
  status      String  @default("planned")
  notes       String?

  beanId String?
  bean   Bean?   @relation(fields: [beanId], references: [id], onDelete: SetNull)

  roasterDefinitionId String?
  roasterDefinition   RoasterDefinition? @relation(fields: [roasterDefinitionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Plans belong to the team — shared by every member, like Bean, not
  // per-user like Brew.
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([month])
}

// A named blend: component beans plus their share of the blend (0–100,
// must sum to 100 — validated in inventory-actions.ts). Logging a blend
// roast creates one RoastSession per component (each deducting its own
// bean's green stock) sharing a blendBatchId — so weight loss, cost, and
// cupping all keep working per component through the existing models,
// and the batch id is what groups them back into "one blend roast" for
// display. Plans never move stock; blend recipes don't either — only the
// RoastSessions created from them do.
model BlendRecipe {
  id    String  @id @default(cuid())
  name  String
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Blend recipes belong to the team — shared by every member, like Bean,
  // not per-user like Brew.
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  components    BlendComponent[]
  roastSessions RoastSession[]

  @@index([teamId])
}

model BlendComponent {
  id String @id @default(cuid())

  blendRecipeId String
  blendRecipe   BlendRecipe @relation(fields: [blendRecipeId], references: [id], onDelete: Cascade)

  beanId String
  bean   Bean   @relation(fields: [beanId], references: [id], onDelete: Restrict)

  // Share of the blend as a percentage (0–100); all components of one
  // recipe must sum to exactly 100 (validated in the action, not the DB).
  ratioPercent Float

  @@index([blendRecipeId])
}

model RoastSession {
  id                     String        @id @default(cuid())
  beanId                 String
  bean                   Bean          @relation("BeanRoasts", fields: [beanId], references: [id], onDelete: Restrict)
  startedAt              DateTime?
  endedAt                DateTime?
  greenWeightGrams       Float
  roastedWeightGrams     Float?
  roastedRemainingGrams  Float?
  roastLevel             String?
  rating                 Int?
  notes                  String?
  // AI roast suggestion (src/lib/roastAdvisor.ts), generated pre-roast from
  // this bean's own roast+cupping history plus these inputs. Kept on the
  // session (not thrown away after use) so future suggestions for the same
  // bean can see what was asked for and tried last time — the whole point
  // of the feedback loop is not re-deriving this from scratch every roast.
  ambientTempF           Float?
  roastGoal              String?
  brewTarget             String?
  suggestedFanLevel      Int?
  suggestedHeatLevel     Int?
  // Terse one-line takeaway (shown by default) vs. the full science+history
  // rationale (behind an expand toggle) — see AiSuggestionPanel.
  aiSuggestionSummary    String?
  aiSuggestionNotes      String?
  // JSON-stringified { settingChanges: [...], targets: {...} } — see
  // RoastPlan in roastAdvisor.ts. A plain String column (not Prisma's Json
  // type) to match this schema's existing plain-scalar style; parsed with
  // JSON.parse where read.
  aiSuggestionPlan       String?
  // Set by acceptRoastSuggestion (a plain DB write, no LLM call) — gates
  // whether this plan's target milestones/drop temp actually render as
  // dashed reference lines on the live chart (src/lib/curve.ts), so a
  // suggestion the roaster never acted on doesn't clutter the chart.
  aiSuggestionAcceptedAt DateTime?
  // Free-text correction the roaster leaves after trying a suggestion (e.g.
  // "fan 8/heat 8 roasted way faster than predicted, done in 5 min") — a
  // plain DB write via recordSuggestionFeedback (no LLM call, so recording
  // it is free), fed into future generateRoastAdvice calls for ANY bean via
  // summarizeMachineCalibration since a dial-timing correction is a fact
  // about the machine, not this one bean.
  aiSuggestionFeedback   String?
  // Soft "started from this profile" link (mirrors Brew.recipeId) — set by
  // applyRoastProfile, which copies the profile's plan onto this session's
  // own aiSuggestion* columns above rather than referencing it live, so
  // deleting a profile never touches past roasts. Cleared back to null by
  // generateRoastSuggestion if the roaster asks for a fresh AI suggestion
  // afterward, since the session no longer actually reflects this profile
  // once that happens.
  profileId              String?
  profile                RoastProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  // Which physical machine this roast was run on, and therefore which
  // controls/probes it has — see RoasterDefinition. Restrict, not Cascade:
  // deleting a roaster definition isn't a feature yet, and shouldn't be
  // able to silently take roast history down with it (same reasoning as
  // Bean above).
  roasterDefinitionId String
  roasterDefinition   RoasterDefinition @relation(fields: [roasterDefinitionId], references: [id], onDelete: Restrict)

  events              RoastEvent[]
  sales               Sale[]
  cuppingNotes        CuppingNote[]
  temperatureReadings TemperatureReading[]
  brews               Brew[]

  goldenForBean Bean? @relation("BeanGoldenRoast")

  // Picked during setup (before the timer starts) so the live view can
  // overlay this roast's curve-so-far against another one in real time —
  // separate from tips.ts's automatic golden/last-roast reference, which
  // only drives text tips, never a chart. onDelete: SetNull so deleting
  // the roast being compared against doesn't cascade into deleting this
  // one too.
  compareToId String?
  compareTo   RoastSession?  @relation("RoastComparison", fields: [compareToId], references: [id], onDelete: SetNull)
  comparedBy  RoastSession[] @relation("RoastComparison")

  // Same team ownership as Bean above.
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Blend roasts: logging a blend creates one RoastSession per component
  // bean (each deducting its own green stock); blendBatchId is the shared
  // id grouping those component sessions back into one "blend roast" for
  // display, and blendRecipeId is the soft link back to the recipe (SetNull
  // so deleting a recipe doesn't delete the roast history).
  blendRecipeId String?
  blendRecipe   BlendRecipe? @relation(fields: [blendRecipeId], references: [id], onDelete: SetNull)
  blendBatchId  String?

  @@index([beanId])
  @@index([startedAt])
  @@index([profileId])
  @@index([teamId])
  @@index([roasterDefinitionId])
  @@index([blendBatchId])
}

// A catalog entry describing one physical roasting machine's controls and
// temperature probes — what makes the live-roast UI, event log, curve
// chart, and CSV export generic across roasters that aren't the Fresh
// Roast SR800 this app was originally built for (fluid-bed, two dials:
// fan and heat). controlsJson/probesJson are JSON-stringified
// RoasterControl[]/RoasterProbe[] (src/lib/roasters.ts) — a plain String
// column, not Prisma's Json type, matching this schema's existing
// convention for this exact shape of data (RoastProfile.planJson,
// RoastSession.aiSuggestionPlan): a small, read-as-a-whole-document list
// of typed settings, never filtered/queried on an individual field.
// isDefault marks the one row auto-seeded per team (Fresh Roast SR800)
// that roast setup falls back to — there's no "add your own roaster" UI
// yet, so today every team only ever has the machines seeded for it.
// supportsAiSuggestions is true only for that seeded SR800 row: the AI
// roast advisor's entire prompt argues fluid-bed physics specifically
// (src/lib/roastAdvisor.ts) and would give actively wrong advice on a
// drum or gas roaster, so the profile picker / AI suggestion panel /
// save-as-profile UI are hidden entirely (not just disabled) whenever
// this is false, rather than trying to generalize that prompt too.
model RoasterDefinition {
  id                    String   @id @default(cuid())
  name                  String
  isDefault             Boolean  @default(false)
  supportsAiSuggestions Boolean  @default(false)
  controlsJson          String
  probesJson            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  roastSessions   RoastSession[]
  productionPlans ProductionPlan[]

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// A reusable fan/heat dial schedule + phase targets — the roasting-side
// analogue of Recipe (brewing). Saved from an AI suggestion, a completed
// roast's actual executed events (the most valuable case — "repeat that
// roast"), or built by hand. planJson is the exact RoastPlan shape from
// roastAdvisor.ts ({ settingChanges, targets }), JSON.stringify'd like
// RoastSession.aiSuggestionPlan already is. Applying one copies its values
// onto a RoastSession's own aiSuggestion* columns (see applyRoastProfile in
// profile-actions.ts) rather than referencing it live — not bean-specific,
// since the whole point is reuse across different beans; process/brewTarget
// are optional tags to help find the right one later, not a hard scope.
model RoastProfile {
  id          String   @id @default(cuid())
  name        String
  description String?
  process     String?
  brewTarget  String?
  planJson    String
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roastSessions RoastSession[]

  // Same team ownership as Bean/RoastSession above.
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([process])
  @@index([teamId])
}

model RoastEvent {
  id             String       @id @default(cuid())
  roastSessionId String
  roastSession   RoastSession @relation(fields: [roastSessionId], references: [id], onDelete: Cascade)
  atSeconds      Int
  type           String
  // Frozen — every control-type event (FAN, HEAT, and now others) writes
  // controlValue instead; these two are kept only as the historical
  // backfill source (see the add_roast_event_control_value migration) and
  // are never written to again. Not worth a migration to drop them.
  fanLevel       Int?
  heatLevel      Int?
  // The value for whatever control `type` names — FAN/HEAT today, more to
  // come as other roaster machines' controls get added (see
  // RoasterDefinition below). `type` already doubles as the control's key,
  // so no separate controlKey column is needed.
  controlValue   Float?
  tempFahrenheit Float?
  note           String?
  createdAt      DateTime     @default(now())

  @@index([roastSessionId, atSeconds])
}

// A continuous reading from a live temperature probe (e.g. a bean-temp
// probe on the FreshRoast), arriving every few seconds while a roast
// runs — deliberately not a RoastEvent. Events are discrete, human-visible
// moments (fan/heat changes, cracks, notes); folding in a reading every
// few seconds would flood that table and its timeline UI. atSeconds is
// null for readings recorded before the roast timer starts — the probe
// can already be posting during setup, which is how "connected" gets
// detected without a manual toggle (see
// src/app/api/probe/temperature/route.ts). probeType defaults to "bean"
// but isn't constrained, leaving room for a second probe (environment/
// exhaust temp, the other half of a typical BT/ET rig) later without a
// migration.
model TemperatureReading {
  id             String       @id @default(cuid())
  roastSessionId String
  roastSession   RoastSession @relation(fields: [roastSessionId], references: [id], onDelete: Cascade)
  atSeconds      Int?
  tempFahrenheit Float
  probeType      String       @default("bean")
  recordedAt     DateTime     @default(now())

  @@index([roastSessionId, atSeconds])
}

// A "drop" — roasted coffee sold/given to a Friend, drawn from one
// RoastSession's roastedRemainingGrams.
model Sale {
  id             String       @id @default(cuid())
  roastSessionId String
  roastSession   RoastSession @relation(fields: [roastSessionId], references: [id], onDelete: Cascade)
  friendId       String?
  friend         Friend?      @relation(fields: [friendId], references: [id], onDelete: SetNull)
  weightGrams    Float
  price          Float?
  soldAt         DateTime     @default(now())
  notes          String?
  createdAt      DateTime     @default(now())

  fulfillsOrderItem DropOrderItem?

  // Set when this Sale is the roasted-stock half of a paid online-shop order
  // (see ShopOrderItem) — a plain Sale otherwise. Reusing Sale (rather than a
  // parallel ledger) keeps online orders counted by everything that already
  // reads roast ledgers and the business/margin page.
  shopOrderItemId String?
  shopOrderItem   ShopOrderItem? @relation(fields: [shopOrderItemId], references: [id], onDelete: SetNull)

  @@index([roastSessionId])
  @@index([friendId])
  @@index([shopOrderItemId])
}

// A cupping session for a roasted coffee — the SCA/Q-grading-style
// evaluation, done separately from (and usually days after) the roast
// itself. A roast can have several of these over time (e.g. day-2 vs
// day-7 rest). Every score field is optional — the Q form's real 10
// categories (7 scored 6-10, 3 scored 0-10 from a home-cupping
// simplification of the professional 5-cups-per-category protocol) plus a
// defects deduction, but a cupper can fill in just notes and an overall
// score, or nothing quantitative at all. See src/lib/cupping.ts for the
// field list/order and how these combine into a total score.
model CuppingNote {
  id             String        @id @default(cuid())
  // A cupping attaches to a roast OR directly to a green lot — exactly one
  // must be set (enforced in the action, same app-level-constraint pattern
  // as Brew's roastSessionId/beanName). Roast-attached cuppings are the
  // original Q-grading flow; lot-attached ones are the inventory side's
  // green-sample / arrival-sample notes.
  roastSessionId String?
  roastSession   RoastSession? @relation(fields: [roastSessionId], references: [id], onDelete: Cascade)
  beanId         String?
  bean           Bean?         @relation(fields: [beanId], references: [id], onDelete: Cascade)
  cuppedAt       DateTime      @default(now())

  fragranceAroma Float?
  flavor         Float?
  aftertaste     Float?
  acidity        Float?
  body           Float?
  balance        Float?
  uniformity     Float?
  cleanCup       Float?
  sweetness      Float?
  overall        Float?
  defects        Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roastSessionId])
  @@index([beanId])
}

// A person drops go to — lets you see everything one friend has ever
// received, across every roast, not just a free-text name per sale.
model Friend {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales      Sale[]
  dropOrders DropOrder[]

  // Same team ownership as Bean/RoastSession/RoastProfile above.
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([teamId])
}

// A curated pre-order menu — "here are N beans, pick what you want roasted
// as, and I'll fulfill it when I roast next." Public, unauthenticated
// visitors all reach the same static /drop page (src/app/drop/page.tsx)
// and type in `code` by hand — a short spoken/texted code, not a link, so
// this page has to defend against being guessed by brute force itself
// (see DropCodeAttempt below) rather than relying on length/entropy alone
// the way a URL-embedded token could. A correct code sets a signed,
// httpOnly cookie (src/lib/drop-actions.ts's redeemDropCode) rather than
// exposing the drop's id anywhere client-visible. Doesn't reserve anything
// out of a bean's green stock at creation time (unlike the old
// gram-reservation design this replaced) — beans here are just a menu;
// stock only ever moves via actual roasting, and fulfilling an order item
// (below) draws down *roasted* stock the same way selling any other roast
// output already does.
model Drop {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  notes     String?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items  DropItem[]
  orders DropOrder[]

  // Whichever team created this drop — a public order submitted against it
  // (submitDropOrder) has no session of its own, so this is also what any
  // Friend it matches/creates gets scoped to.
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// One bean listed on a drop's menu — an explicit join (replacing the old
// plain Bean<->Drop many-to-many) specifically so each listing can carry
// its own price and stock count, neither of which a bare m2m can express.
// stockQuantity is a simple bag-level count set by the admin when building
// the drop (e.g. "I have 3 bags of this") — deliberately not tied to
// Bean.remainingGrams or RoastSession.roastedRemainingGrams (both
// gram-precise, tracked per bean/roast respectively, and used for the
// *admin's* own inventory bookkeeping); this is a much coarser "how many
// can I let people claim" cap that only exists on the listing itself, and
// null means unlimited/not tracked — every listing created before this
// concept existed backfills to null (see this model's migration) rather
// than inventing a number the admin never actually entered. Decremented by
// submitDropOrder at claim time (not later at fulfillment, unlike the
// gram-level ledgers above), restored by deleteDropOrder/deleteDropOrderItem
// if a claim is removed.
model DropItem {
  id            String   @id @default(cuid())
  dropId        String
  drop          Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  beanId        String
  bean          Bean     @relation(fields: [beanId], references: [id], onDelete: Cascade)
  price         Float?
  stockQuantity Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([dropId, beanId])
  @@index([dropId])
  @@index([beanId])
}

// A record of one code-entry attempt on the public /drop page, keyed by
// the requester's IP — exists purely so redeemDropCode can count recent
// attempts and lock out a source that's guessing codes faster than a
// human plausibly would. Deliberately its own tiny table rather than
// reusing AiSuggestionCall/SupplierExtractionCall's shape: those enforce a
// global daily budget, this enforces a per-IP short-window lockout, a
// different query pattern (WHERE ip = ? AND attemptedAt > ?) that wants
// its own index rather than overloading calledAt's.
model DropCodeAttempt {
  id          String   @id @default(cuid())
  ip          String
  attemptedAt DateTime @default(now())

  @@index([ip, attemptedAt])
}

// One person's submission against a Drop — one name, one or more
// DropOrderItem picks. friendId resolves the same case-insensitive
// match-or-create-a-Friend pattern addDropClaim/recordSale already use
// (src/lib/drop-actions.ts), so a pre-order shows up in that person's own
// history alongside their other sales; `name` keeps what they actually
// typed verbatim regardless of the match.
model DropOrder {
  id        String   @id @default(cuid())
  dropId    String
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  friendId  String?
  friend    Friend?  @relation(fields: [friendId], references: [id], onDelete: SetNull)
  name      String
  createdAt DateTime @default(now())

  items DropOrderItem[]

  @@index([dropId])
  @@index([friendId])
}

// One bean pick within a DropOrder. "Fulfilled" isn't a checkbox: it
// means a real Sale exists (saleId), drawn from an actual completed
// roast's roastedRemainingGrams once that roast happens — the item and the
// roasted-stock ledger stay reconciled through the same Sale row rather
// than two disconnected trackers, exactly like the old DropClaim this
// replaced. paid is independent and stays a plain boolean, since pre-order
// money often changes hands before anything's even roasted.
model DropOrderItem {
  id          String    @id @default(cuid())
  dropOrderId String
  dropOrder   DropOrder @relation(fields: [dropOrderId], references: [id], onDelete: Cascade)
  beanId      String
  bean        Bean      @relation(fields: [beanId], references: [id], onDelete: Restrict)
  // Buyers no longer pick a roast style (Filter/Omni/Espresso) — the field
  // stays, nullable, purely so pre-existing orders keep showing what was
  // actually picked at the time; see constants.ts's DROP_ORDER_ROAST_STYLE_LABELS.
  roastStyle  String?
  price       Float?
  paid        Boolean   @default(false)
  saleId      String?   @unique
  sale        Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([dropOrderId])
  @@index([beanId])
}

// Who's allowed to sign in via OAuth (checked in auth.ts's signIn callback)
// and, via isAdmin, who's allowed to manage this table through the /admin
// portal. Replaces the old ALLOWED_EMAILS env var, which required a
// redeploy to change. isAdmin is a platform-wide flag (manages the whole
// allowlist across every team, via /admin) — separate from team
// membership itself, which has no per-team roles yet (every member of a
// team sees/edits the same team data equally; see Team's own comment).
model AllowedUser {
  id        String   @id @default(cuid())
  email     String   @unique
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  brews      Brew[]
  syncTokens SyncToken[]
}

// A credential letting a desktop install pull/push this one person's team
// data over the sync API (src/app/api/sync/*), without ever handing the
// client a database credential directly — see src/lib/sync-tokens.ts.
// Minted automatically inside auth.ts's signIn callback the moment a real
// OAuth sign-in confirms someone's on the allowlist (no separate "generate
// a token" UI to build or copy/paste to get wrong), but kept as its own
// row — not just a bare secret in desktop-config.json — so it's visible
// and individually revocable from /admin without having to remove the
// person's whole account to cut off one compromised/lost device. Only
// `tokenHash` (sha256 of the actual token) is ever stored; the plaintext
// exists only at mint time, written straight into that install's own
// desktop-config.json and never persisted here.
model SyncToken {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  label      String?
  userId     String
  user       AllowedUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime    @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// A credential letting the local probe bridge script
// (scripts/probe_bridge.py) post temperature readings into one specific
// team's active roast — see src/lib/probe-tokens.ts. Scoped to a Team
// rather than an AllowedUser like SyncToken above: the probe script is a
// machine credential for whichever roaster/laptop sits next to the
// hardware, not tied to one person signing in, and what it needs to
// resolve is exactly "which team's active RoastSession does this reading
// belong to" (api/probe/temperature/route.ts). Before this model existed,
// every team shared one flat PROBE_INGEST_TOKEN env var and the ingest
// endpoint picked whichever team's session had the most recent
// createdAt — harmless with a single team in production, but silently
// wrong the moment a second team's roast was live at the same time.
// Minted from /admin per team (unlike SyncToken, which mints itself at
// OAuth sign-in — there's no per-person sign-in step for a machine
// credential like this one). Only tokenHash is ever stored; the plaintext
// exists only at mint time.
model ProbeToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  label      String?
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([teamId])
}

// A team is the actual unit of data ownership — Bean/RoastSession/Friend/
// Drop/RoastProfile/Recipe all belong to a Team, not an individual
// AllowedUser, and every member of a team sees/edits the exact same data
// (no per-team roles yet — isAdmin on AllowedUser is a separate,
// platform-wide concept, not a per-team one). This is the "Organization"
// concept AGENTS.md's "Multi-device / sharing with a friend" section
// anticipated and deliberately deferred until a second one actually
// showed up — named Team here since that's the word actually used when
// building it. onDelete: Restrict on AllowedUser.teamId (not Cascade)
// means a team can't be silently orphaned/emptied as a side effect of
// removing a person; team deletion itself isn't a feature yet.
model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members              AllowedUser[]
  beans                Bean[]
  roastSessions        RoastSession[]
  productionPlans      ProductionPlan[]
  blendRecipes         BlendRecipe[]
  friends              Friend[]
  drops                Drop[]
  roastProfiles        RoastProfile[]
  recipes              Recipe[]
  roasterDefinitions   RoasterDefinition[]
  probeTokens          ProbeToken[]
  beanListings         BeanListing[]
  shopSettings         ShopSettings?
  shopOrders           ShopOrder[]
  inventoryWidgetPrefs InventoryWidgetPrefs?
}

// Dashboard widget visibility for the inventory app — which widgets the
// team has hidden on /inventory. One row per team, created on first save;
// absent means everything visible (the default).
model InventoryWidgetPrefs {
  id            String   @id @default(cuid())
  teamId        String   @unique
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  hiddenWidgets String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A reusable brewing target — not tied to a bean, so the same "V60 4:6"
// recipe can be dialed in once and reused across whatever coffee's on
// hand. Ratio is deliberately not stored; it's cheap to derive from
// doseGrams/waterGrams wherever it's shown.
model Recipe {
  id              String   @id @default(cuid())
  name            String
  method          String
  doseGrams       Float
  waterGrams      Float
  grindSetting    String?
  waterTempF      Float?
  brewTimeSeconds Int?
  notes           String?
  isFavorite      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brews Brew[]

  // Same team ownership as Bean/RoastSession/RoastProfile/Friend above.
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([method])
  @@index([teamId])
}

// One actual brew. roastSessionId is optional — set when it's drawn from
// this app's own tracked roasted stock (decrementing roastedRemainingGrams
// the same way a Sale does), left null with a free-text beanName when it's
// coffee this app never roasted (store-bought, or someone using only the
// brewing side of the app). method/dose/water/etc. are captured directly
// on the Brew (not just read off recipe) so a log reflects what you
// actually did, even if you deviated from the recipe or the recipe gets
// edited/deleted later. recipeId is only a soft "inspired by" link.
model Brew {
  id             String        @id @default(cuid())
  roastSessionId String?
  roastSession   RoastSession? @relation(fields: [roastSessionId], references: [id], onDelete: SetNull)
  beanName       String?
  recipeId       String?
  recipe         Recipe?       @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  // A brew is one person's journal entry, not shared household data like
  // Bean/RoastSession are — each signed-in user only ever sees their own.
  // Stock (roastedRemainingGrams) is still one shared pool, though: several
  // people can brew from the same bag, they just don't see each other's logs.
  userId         String
  user           AllowedUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  method          String
  doseGrams       Float
  waterGrams      Float
  grindSetting    String?
  waterTempF      Float?
  brewTimeSeconds Int?
  rating          Int?
  notes           String?
  brewedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([roastSessionId])
  @@index([recipeId])
  @@index([userId])
}

// One row per generateRoastSuggestion call (src/lib/actions.ts) — exists
// purely to enforce AI_SUGGESTION_DAILY_LIMIT, a global (not per-user) rate
// limit on the Anthropic API key: roasting data in this app is shared
// across everyone allowlisted, not per-user like Brew, so a global cap is
// the natural fit and needs no user-tracking of its own. This bounds
// worst-case spend independently of (not instead of) the spend limit set
// directly in the Anthropic Console.
model AiSuggestionCall {
  id       String   @id @default(cuid())
  calledAt DateTime @default(now())

  @@index([calledAt])
}

// Same global daily-limit pattern as AiSuggestionCall, kept as its own
// table (not sharing AiSuggestionCall's) since fetchSupplierInfo is a
// separate, lighter-weight feature with its own rate budget.
model SupplierExtractionCall {
  id       String   @id @default(cuid())
  calledAt DateTime @default(now())

  @@index([calledAt])
}

// ─── Online shop (apps/shop) ────────────────────────────────────────────────
// apps/shop is a separate public storefront that reads this same database;
// this app (apps/roasting) owns the schema and every migration. Square is the
// payment/order system of record; THIS database is the inventory system of
// record (Square inventory tracking stays off) — see src/lib/shop-stock.ts.

// A bean's public shop listing. Kept off Bean itself so the many existing
// Bean reads/writes don't change, and so an unlisted bean simply has no row
// (or isListed=false) rather than a pile of nullable shop fields.
model BeanListing {
  id           String   @id @default(cuid())
  beanId       String   @unique
  bean         Bean     @relation(fields: [beanId], references: [id], onDelete: Cascade)
  isListed     Boolean  @default(false)
  slug         String   @unique
  headline     String?
  // Customer-facing copy. Falls back to Bean.tastingNotes when null.
  description  String?
  roastStyle   String?
  brewNotes    String?
  sortOrder    Int      @default(0)
  // Square Catalog ITEM id — set by the catalog sync on save.
  squareItemId String?
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants ListingVariant[]

  @@index([teamId, isListed])
}

// A bag size + price for one listing (e.g. "12 oz" / 340g / $27). Prices are
// integer cents, never floats, since they become Square money amounts.
model ListingVariant {
  id                String      @id @default(cuid())
  listingId         String
  listing           BeanListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  label             String
  grams             Float
  priceCents        Int
  active            Boolean     @default(true)
  sortOrder         Int         @default(0)
  // Square Catalog ITEM_VARIATION id — set by the catalog sync on save.
  squareVariationId String?

  @@index([listingId])
}

// One online-shop checkout. Created PENDING when the customer is sent to
// Square's hosted checkout; flipped to PAID only by the Square webhook
// (never by the redirect back, which is spoofable and unreliable).
model ShopOrder {
  id            String    @id @default(cuid())
  publicRef     String    @unique
  squareOrderId String?   @unique
  paymentLinkId String?
  // PENDING | PAID | READY | FULFILLED | CANCELED | NEEDS_ATTENTION
  status        String    @default("PENDING")
  // PICKUP | SHIPMENT
  fulfillment   String
  pickupAt      DateTime?
  customerName  String
  customerEmail String
  customerPhone String?
  subtotalCents Int
  shippingCents Int       @default(0)
  totalCents    Int?
  paidAt        DateTime?
  // Why a paid order needs a human (e.g. stock ran out between checkout and payment).
  attentionNote String?
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items ShopOrderItem[]

  @@index([teamId, status])
}

// One line of a ShopOrder. A copy of what was bought at checkout time
// (label/grams/price), not a live link to ListingVariant, so editing or
// deleting a variant later never rewrites a past order. gramsFromRoasted /
// gramsToRoast are filled in when the order is paid (see shop-stock.ts).
model ShopOrderItem {
  id               String    @id @default(cuid())
  orderId          String
  order            ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  beanId           String
  bean             Bean      @relation(fields: [beanId], references: [id], onDelete: Restrict)
  variantLabel     String
  grams            Float
  quantity         Int
  unitPriceCents   Int
  gramsFromRoasted Float     @default(0)
  gramsToRoast     Float     @default(0)

  sales Sale[]

  @@index([orderId])
  @@index([beanId])
}

// Square webhook idempotency — Square delivers at-least-once, so every
// handled event_id is recorded and duplicates are skipped.
model ProcessedSquareEvent {
  eventId    String   @id
  receivedAt DateTime @default(now())
}

// Everything about the public storefront that isn't a coffee — edited by the
// team from the roasting app's /shop page, read by apps/shop. One row per
// team; apps/shop falls back to built-in defaults when it doesn't exist yet.
// Shipping lives here (not hard-coded in apps/shop) because checkout charges
// it, so the rule customers read and the rule they're charged must be one value.
model ShopSettings {
  id                    String   @id @default(cuid())
  teamId                String   @unique
  team                  Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Optional banner across the top of every page (e.g. "This week's roast: Sep 22").
  announcement          String?
  tagline               String   @default("Small-batch coffee, roasted in San Francisco")
  heroHeadline          String   @default("Small-batch coffee from a tiny roaster in San Francisco.")
  heroBody              String   @default("We roast a few coffees at a time, in small batches, and sell them by the bag. Pick it up or get it delivered in San Francisco, or have it shipped.")
  localSummary          String   @default("Pickup or local delivery in San Francisco")
  noticeDays            Int      @default(2)
  shippingFlatCents     Int      @default(600)
  freeShippingOverCents Int      @default(5000)
  instagramUrl          String?  @default("https://www.instagram.com/cybarcoffee")
  aboutIntro            String?
  // Paragraphs separated by blank lines. A line starting with "## " is a heading.
  aboutBody             String?
  updatedAt             DateTime @updatedAt
}
