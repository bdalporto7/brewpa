# Copy to .env and fill in. Never commit the real .env — it's gitignored.

# Local dev: a SQLite file. Once deployed to Turso, this becomes
# TURSO_DATABASE_URL + TURSO_AUTH_TOKEN instead (see AGENTS.md).
DATABASE_URL="file:./dev.db"

# Auth — a single shared password gating the whole app (see src/lib/auth.ts).
# AUTH_SECRET signs the session cookie; generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""
APP_PASSWORD=""
