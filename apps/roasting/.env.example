# Copy to .env and fill in. Never commit the real .env — it's gitignored.

# Local dev: a SQLite file. Set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN below
# to use the hosted database instead — src/lib/prisma.ts prefers Turso when
# both are set, falling back to this file otherwise.
DATABASE_URL="file:./dev.db"

# Turso (hosted libSQL) — see AGENTS.md for how the database was created
# and migrated. Leave both blank to keep using the local file above.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Auth (Auth.js / next-auth) — see src/auth.ts. AUTH_SECRET encrypts session
# tokens; generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# OAuth app credentials — register apps with GitHub and Google first (see
# AGENTS.md for the exact callback URLs each one needs).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated list of emails allowed to sign in — everyone else is
# rejected even with a valid GitHub/Google login.
ALLOWED_EMAILS=""
