# Copy to .env and fill in. Never commit the real .env — it's gitignored.

# Local dev: a SQLite file. Set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN below
# to use the hosted database instead — src/lib/prisma.ts prefers Turso when
# both are set, falling back to this file otherwise.
DATABASE_URL="file:./dev.db"

# Turso (hosted libSQL) — see AGENTS.md for how the database was created
# and migrated. Leave both blank to keep using the local file above.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Auth (Auth.js / next-auth) — see src/auth.ts. AUTH_SECRET encrypts session
# tokens; generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# OAuth app credentials — register apps with GitHub and Google first (see
# AGENTS.md for the exact callback URLs each one needs).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Who's allowed to sign in lives in the AllowedUser table, not an env var —
# seed the first admin directly in the database, then manage everyone else
# from /admin. See AGENTS.md.

# Shared secret for the temperature-probe ingest endpoint
# (/api/probe/temperature) — generate with `openssl rand -base64 32`.
# Whatever script reads your physical probe sends this back as
# `Authorization: Bearer <token>`. See AGENTS.md's "Temperature probe"
# section.
PROBE_INGEST_TOKEN=""

# Anthropic API key for AI pre-roast suggestions (src/lib/roastAdvisor.ts,
# generateRoastSuggestion in src/lib/actions.ts) — get one at
# https://console.anthropic.com/settings/keys. Without this set, generating
# a suggestion fails with a clear error; nothing else in the app depends on it.
ANTHROPIC_API_KEY=""

# Required alongside the key above if it's identity-linked to a specific
# Workspace (Console → Settings → Workspaces → your workspace's ID, looks
# like "wrkspc_..."). Not a secret — just tells Anthropic which workspace
# the request acts in. Requests 400 without it if the key needs it.
ANTHROPIC_WORKSPACE_ID=""
