// This is your Prisma schema file for PostgreSQL production deployment
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CoffeeEntry {
  id               String   @id @default(cuid())
  name             String
  roastLevel       String   // light, medium-light, medium, medium-dark, dark, very-dark
  origin           String
  grindSize        String   // extra-fine, fine, medium-fine, medium, medium-coarse, coarse, extra-coarse
  brewMethod       String   // espresso, pour-over, french-press, aeropress, moka-pot, cold-brew, drip, siphon, chemex, v60, kalita, other
  waterTemperature Float
  coffeeWeight     Float
  waterWeight      Float
  brewTime         Float
  rating           Float
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Indexes for better query performance
  @@index([createdAt])
  @@index([brewMethod])
  @@index([roastLevel])
  @@index([rating])
  @@index([origin])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Future: Add user-specific coffee entries
  // coffeeEntries CoffeeEntry[]
}

// Future models for enhanced features
model CoffeeBean {
  id          String   @id @default(cuid())
  name        String
  origin      String
  roastLevel  String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BrewingRecipe {
  id               String   @id @default(cuid())
  name             String
  description      String?
  brewMethod       String
  grindSize        String
  waterTemperature Float
  coffeeWeight     Float
  waterWeight      Float
  brewTime         Float
  instructions     String?
  isPublic         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
} 